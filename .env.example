# --- x402 WebReader configuration -------------------------------------------

# Coinbase Wallet address on Base that receives USDC payments.
# Leave unset for free local testing (endpoint runs without the paywall).
PAY_TO_ADDRESS=

# Network: eip155:84532 = Base Sepolia testnet (default, test money)
#          eip155:8453  = Base mainnet (LIVE money — set only when ready)
X402_NETWORK=eip155:84532

# Facilitator that verifies and settles payments.
# Default is the public testnet facilitator. For mainnet, use the Coinbase
# CDP facilitator (requires CDP API keys) or another mainnet facilitator.
FACILITATOR_URL=https://x402.org/facilitator

# Price per read.
PRICE=$0.005
