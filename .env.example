# --- x402 WebReader configuration -------------------------------------------

# Coinbase Wallet address on Base that receives USDC payments.
# Leave unset for free local testing (endpoint runs without the paywall).
PAY_TO_ADDRESS=

# Network: eip155:84532 = Base Sepolia testnet (default, test money)
#          eip155:8453  = Base mainnet (LIVE money — set only when ready)
X402_NETWORK=eip155:84532

# Facilitator that verifies and settles payments (used when no CDP keys
# are set). Default is the public testnet facilitator. For mainnet without
# CDP keys, PayAI's public facilitator works: https://facilitator.payai.network
FACILITATOR_URL=https://x402.org/facilitator

# Coinbase CDP API keys (free from https://cdp.coinbase.com).
# When BOTH are set, payments settle through Coinbase's CDP facilitator
# instead of FACILITATOR_URL — required for Coinbase Bazaar cataloging.
# The secret is shown once at creation; store it only here / in Vercel.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Price per read.
PRICE=$0.10

# Firecrawl API key (optional fallback reader — https://firecrawl.dev).
# When set, pages the built-in reader fails on (JavaScript-heavy or
# blocked pages) or reads as near-empty are retried through Firecrawl,
# which renders them in a real browser. Each rescued read costs Firecrawl
# credits, so it only runs as a fallback. Leave unset to disable.
FIRECRAWL_API_KEY=

# --- Research endpoint (POST /api/research) ---------------------------------

# Price per research call.
RESEARCH_PRICE=$1.00

# Tavily API key (REQUIRED for /api/research — https://tavily.com).
# Tavily runs the web search and extracts the source pages.
TAVILY_API_KEY=

# LLM keys (optional, first set wins: OpenAI, then Anthropic).
# When one is set, the briefing is synthesized by that model from the full
# source text with citations. With neither set, the endpoint falls back to
# Tavily's own generated answer plus source extracts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override for the synthesis step.
LLM_MODEL=
